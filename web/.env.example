# App Configuration (Optional - has defaults in next.config.ts)
# Only set these if you want to override the defaults
NEXT_PUBLIC_APP_NAME=Chem IRL
NEXT_PUBLIC_DOMAIN=chemirl.app

# Supabase (REQUIRED for the waitlist form on /download to work)
# Get these from the Supabase Dashboard:
#   Settings → API → Project URL  +  Publishable (anon) key
# Both must use the NEXT_PUBLIC_ prefix to be exposed to the static build.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Plausible Analytics (Optional)
# Set this only in the Production environment on Vercel (leave Preview/dev
# blank to avoid polluting prod stats). When unset, the analytics script is
# not rendered at all — zero network calls, zero cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=chemirl.app
