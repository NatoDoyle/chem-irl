# App Configuration
NEXT_PUBLIC_APP_NAME=Chem IRL
NEXT_PUBLIC_DOMAIN=chemirl.app
NEXT_PUBLIC_APP_URL=https://chemirl.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Community — public Discord invite URL surfaced on /support. When unset
# (the default), the support page hides the Community card and shows
# only the email contact. Set in Vercel project env vars when you have
# a real invite URL.
NEXT_PUBLIC_COMMUNITY_DISCORD_URL=

# Sentry (optional) — must be NEXT_PUBLIC_-prefixed so the browser SDK
# in src/components/SentryInit.tsx can read it. Set in Vercel project
# env vars; only initializes when NEXT_PUBLIC_VERCEL_ENV=production.
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# Email — Resend
#
# IMPORTANT: these MUST live as Supabase Edge Function secrets, set via:
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set WAITLIST_EMAIL_FROM='Chem IRL <hello@chemirl.app>'
#   supabase secrets set RESEND_AUDIENCE_WAITLIST_ID=xxx
#   supabase secrets set RESEND_AUDIENCE_BLOG_ID=xxx
#
# The Resend↔Vercel and Resend↔Supabase native marketplace integrations do
# NOT populate Edge Function secrets:
#   - The Vercel integration writes RESEND_API_KEY into the Vercel project's
#     env vars (consumed by Next.js server code, which we don't have here —
#     the marketing site is a static export).
#   - The Supabase integration configures Resend as Supabase Auth's SMTP
#     provider for auth emails (welcome, OTP, password reset). It does not
#     give the runtime of custom Edge Functions access to RESEND_API_KEY.
#
# If confirmation emails appear to vanish silently, check (in order):
#   1) supabase secrets list   — all four keys above must be present
#   2) Resend dashboard → Domains — the sender domain must show "Verified"
#   3) supabase functions logs waitlist-signup --tail   while submitting
#      a test signup; look for "RESEND_API_KEY not set" or "Resend send
#      failed". The edge functions intentionally fail-soft so the user
#      gets a successful response even when the email path is broken.
RESEND_API_KEY=your_resend_api_key
WAITLIST_EMAIL_FROM=Chem IRL <hello@chemirl.app>
RESEND_AUDIENCE_WAITLIST_ID=your_resend_waitlist_audience_id
RESEND_AUDIENCE_BLOG_ID=your_resend_blog_audience_id

# SMS — reserved for pre-beta SMS 2FA. Not in use yet.
# When wired up, Supabase Auth's Phone provider will read these
# (configured in the Supabase Dashboard, not here).
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# Environment
NODE_ENV=development




