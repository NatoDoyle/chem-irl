# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_publishable_key

# App Configuration
EXPO_PUBLIC_APP_URL=https://chemirl.app

# Optional: Error Logging (Sentry)
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
EXPO_PUBLIC_ENVIRONMENT=development

# Optional in dev: Expo push notifications (required in production builds).
# EAS project id used by getExpoPushTokenAsync — must match
# extra.eas.projectId in app.json.
EXPO_PUBLIC_PROJECT_ID=40fbab02-b775-4e8b-9b3c-011528e37684

# Optional: photo safety + identity verification onboarding step
EXPO_PUBLIC_ENABLE_PHOTO_VERIFICATION=false
