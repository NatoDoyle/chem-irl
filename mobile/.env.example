# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_publishable_key

# App Configuration
EXPO_PUBLIC_APP_URL=https://chemirl.app

# Magic Link Authentication Redirect
# Deep link URL for magic link authentication
# Format: <scheme>://auth/callback
# Defaults to Linking.createURL('/auth/callback') if not set
EXPO_PUBLIC_AUTH_REDIRECT_URL=chemirl://auth/callback

# Optional: Error Logging (Sentry)
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
EXPO_PUBLIC_ENVIRONMENT=development
