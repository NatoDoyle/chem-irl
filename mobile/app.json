{
  "expo": {
    "name": "Chem IRL",
    "slug": "chem-irl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1453FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.chemirl.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1453FF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.chemirl.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "chemirl",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chem IRL to access your photos to upload profile pictures."
        }
      ]
    ]
  }
}
