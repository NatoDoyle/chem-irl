EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_staging_publishable_key_here

# Magic Link Authentication Redirect
# For Expo Go: Uses exp://localhost:8081/--/auth/callback (handled automatically)
# For dev/prod builds: Use chemirl://auth/callback (matches app.json scheme)
# See docs/AUTH_MAGIC_LINK_STAGING.md for Supabase redirect URL configuration
EXPO_PUBLIC_AUTH_REDIRECT_URL=chemirl://auth/callback
