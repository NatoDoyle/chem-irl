{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "bun run test:unit",
    "test:unit": "jest -c jest.unit.config.js",
    "test:native": "jest -c jest.native.config.js",
    "check:env": "tsx scripts/checkEnv.ts",
    "prebuild": "bun run check:env",
    "use:staging": "tsx scripts/switchEnv.ts staging",
    "use:production": "tsx scripts/switchEnv.ts production",
    "verify:staging": "tsx scripts/verifySupabase.ts",
    "test:two-device": "tsx scripts/printTwoDeviceWorkflow.ts",
    "test:log:new": "tsx scripts/newTestRunLog.ts",
    "test:beta:smoke:new": "tsx scripts/newBetaSmokeRun.ts",
    "test:beta:smoke": "echo '📋 Beta Smoke Checklist: docs/BETA_SMOKE_CHECKLIST.md' && echo '📱 Install Guide: docs/INSTALL_ON_PHONES.md' && echo '💡 Run: bun run test:beta:smoke:new'"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/libre-caslon-text": "^0.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.8.11",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.104.1",
    "aes-js": "^3.1.2",
    "babel-preset-expo": "~54.0.10",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "^17.0.9",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "^15.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-iap": "^14.7.18",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/parser": "^7.28.5",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "~29.7.0",
    "jest-expo": "^54.0.17",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "_comment": "Jest config moved to explicit config files. Use 'test:unit' for unit tests (default via 'bun test') or 'test:native' for React Native component tests.",
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "fakeTimers": {
      "enableGlobally": true
    }
  },
  "private": true,
  "overrides": {
    "ws": "~8.18.0"
  }
}
