{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "npm run test:unit",
    "test:unit": "jest -c jest.unit.config.js",
    "test:native": "jest -c jest.native.config.js",
    "check:env": "tsx scripts/checkEnv.ts",
    "prebuild": "npm run check:env",
    "use:staging": "tsx scripts/switchEnv.ts staging",
    "use:production": "tsx scripts/switchEnv.ts production",
    "verify:staging": "tsx scripts/verifySupabase.ts",
    "test:two-device": "tsx scripts/printTwoDeviceWorkflow.ts",
    "test:log:new": "tsx scripts/newTestRunLog.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.8.11",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@react-navigation/stack": "^7.6.11",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.86.2",
    "aes-js": "^3.1.2",
    "expo": "~54.0.27",
    "expo-constants": "^18.0.12",
    "expo-image-picker": "^17.0.9",
    "expo-linking": "^8.0.10",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "^4.2.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/parser": "^7.28.5",
    "@babel/plugin-transform-flow-strip-types": "^7.25.0",
    "@babel/plugin-transform-typescript": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-flow": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "babel-preset-expo": "~11.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.16",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "_comment": "Jest config moved to explicit config files. Use 'test:unit' for unit tests (default via 'npm test') or 'test:native' for React Native component tests.",
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "fakeTimers": {
      "enableGlobally": true
    }
  },
  "private": true
}
