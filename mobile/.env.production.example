EXPO_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_production_publishable_key_here

# Magic Link Authentication Redirect
# Production builds use chemirl://auth/callback (matches app.json scheme)
# Ensure Supabase Redirect URLs allowlist includes: chemirl://auth/callback
# See docs/AUTH_MAGIC_LINK_STAGING.md for configuration details
EXPO_PUBLIC_AUTH_REDIRECT_URL=chemirl://auth/callback
