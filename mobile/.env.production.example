# Production build environment — copy to .env (or set in EAS secrets) and
# fill in real values. `bun run check:env` validates this before builds.

# Supabase (production project)
EXPO_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_production_publishable_key_here

# Environment gate — enables Sentry capture and release behaviour.
# check:env treats production as strict: missing push/Sentry config below
# is flagged instead of failing silently at runtime.
EXPO_PUBLIC_ENVIRONMENT=production

# Error logging (Sentry). Strongly recommended for production builds —
# without it there is no crash reporting.
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Expo push notifications. EAS project id consumed by
# getExpoPushTokenAsync in src/lib/notifications.ts — must match
# extra.eas.projectId in app.json. REQUIRED in production: without it,
# push-token registration silently fails and users never receive
# match/message/proposal notifications.
EXPO_PUBLIC_PROJECT_ID=40fbab02-b775-4e8b-9b3c-011528e37684

# Photo safety + identity verification onboarding step (launch default: on).
# When true, PhotoVerification sits between Photos and LocationPermission
# in onboarding and gates profile completion.
EXPO_PUBLIC_ENABLE_PHOTO_VERIFICATION=true
